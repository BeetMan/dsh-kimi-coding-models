{
  "name": "dsh-kimi-coding-models",
  "version": "0.8.9",
  "type": "module",
  "description": "Keep the kimi-coding LLM route in step with Kimi Coding's live model catalog",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "remote.js",
    "sync-plan.js",
    "kimi-limits.js",
    "quota-trend.js",
    "auto-sync.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "author": "BeetMan (https://github.com/BeetMan)",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeetMan/dsh-kimi-coding-models.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "kimi",
    "kimi-coding",
    "kimi-for-coding",
    "llm",
    "model-sync",
    "quota"
  ]
}
